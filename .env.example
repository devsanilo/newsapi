# ===========================================
# Noozia API - Environment Config
# ===========================================

# Server
NODE_ENV=development
PORT=3000

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=news_aggregator
DB_USER=root
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Crawler Settings
CRAWLER_CONCURRENCY=3
CRAWLER_MAX_RETRIES=3
CRAWLER_RATE_LIMIT_MS=2000
CRON_SCHEDULE=*/5 * * * *

# Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# API
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Video feed configuration
VIDEO_FEED_URLS=https://www.youtube.com/feeds/videos.xml?channel_id=UC4eYXhJI4-7wSWc8UNRwD4A,https://www.youtube.com/feeds/videos.xml?channel_id=UCVYamHliCI9rw1tHR1xbkfw
VIDEO_FEED_CACHE_TTL_MS=300000

# Firebase (FCM Push Notifications)
# Option A: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: Individual credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
