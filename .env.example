# ===========================================
# Noozia API - Environment Config
# ===========================================

# Server
NODE_ENV=development
PORT=3000

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=news_aggregator
DB_USER=root
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Crawler Settings
CRAWLER_CONCURRENCY=3
CRAWLER_MAX_RETRIES=3
CRAWLER_RATE_LIMIT_MS=2000
CRON_SCHEDULE=*/5 * * * *

# Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# API
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Video feed configuration
VIDEO_FEED_URLS=https://www.youtube.com/feeds/videos.xml?channel_id=UC4eYXhJI4-7wSWc8UNRwD4A,https://www.youtube.com/feeds/videos.xml?channel_id=UCVYamHliCI9rw1tHR1xbkfw
VIDEO_FEED_CACHE_TTL_MS=300000

# Firebase (FCM Push Notifications)
# Option A: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: Individual credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Contact form recipient.
# Where messages from https://trenxi.com/contact are delivered. Falls back to
# the SMTP from-address configured in the admin settings when unset, so it is
# only needed if you want them to land in a separate inbox.
CONTACT_EMAIL=

# ─── AI content pipeline (DeepSeek) ───────────────────────────
# Required by the rewrite and originals pipelines. Create one at
# https://platform.deepseek.com. Never commit the real value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_RETRIES=3

# The rewrite pipeline is OFF unless explicitly armed: it spends money on a
# third-party API and writes to the production news table. Its output is staged
# only — nothing becomes reader-visible without approval in the admin queue.
REWRITE_ENABLED=false
REWRITE_CRON=*/10 * * * *
REWRITE_BATCH_SIZE=3
REWRITE_ORDER=recent
REWRITE_MIN_WORDS=250
REWRITE_MAX_WORDS=1200
REWRITE_MAX_SHARED_RUN=12
REWRITE_SOURCE_CHARS=8000

# ─── Schema migrations ────────────────────────────────────────
# Migrations run on boot because the production image is built with
# `npm ci --omit=dev`, so sequelize-cli is not present in the container.
# Applied migrations are recorded in SequelizeMeta — the same table the CLI uses.
MIGRATE_ON_BOOT=true
# Defaults to true: abort start-up when a migration fails. Serving traffic with
# a schema the models disagree with is worse than a deploy that refuses to come
# up. Set false only when the failed migration is known to be unrelated to
# anything the running code touches.
MIGRATE_STRICT=true
# How long a DDL statement waits for its metadata lock before giving up.
# MySQL's default is 31536000 seconds (a year), which turns a blocked ALTER
# into a silent hang — that is what made a broken migration look like nothing
# happening at all. Bounded so it fails loudly instead.
MIGRATE_LOCK_WAIT_SECONDS=120
# Retries when the ALTER is blocked by a metadata lock (ER_LOCK_WAIT_TIMEOUT).
MIGRATE_DDL_RETRIES=4
